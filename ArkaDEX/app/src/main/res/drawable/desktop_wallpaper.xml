<?xml version="1.0" encoding="utf-8"?>
<!-- Default ArkaDEX wallpaper: soft ClayMorphism gradient.
     Replaced at runtime by the system wallpaper when available. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="135"
        android:endColor="#4A90E2"
        android:centerColor="#88C0D0"
        android:startColor="#FAF9FF"
        android:type="linear" />
    <corners android:radius="0dp" />
</shape>
